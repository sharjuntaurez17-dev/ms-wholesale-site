# Secrets / env
.env
.env.local
.env.*.local

# Node / Vercel
node_modules/
.vercel/

# OS files
Thumbs.db
.DS_Store

# Agent tooling — config is tracked (see scripts/setup-agents.sh),
# runtime state and local caches are not.
