.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/daemon-state.json
.claude-flow/daemon.pid
.claude-flow/metrics/
.claude-flow/policy/state.json
.swarm/
ruvector.db
ruvector.db-*

# gstack installs outside the repo (~/gstack); nothing to track here.
.gstack/

# ui-ux-pro-max ships ~3.8 MB of CSV data and reinstalls via
# scripts/setup-agents.sh, so it is not vendored here.
.claude/skills/ui-ux-pro-max/
.claude/skills/design/
.claude/skills/design-system/
.claude/skills/ui-styling/
.claude/skills/brand/
.claude/skills/banner-design/
.claude/skills/slides/

# playwright-cli: skill + session artifacts reinstall via scripts/setup-agents.sh
.claude/skills/playwright-cli/
.playwright-cli/

# Next.js rebuild (web/)
web/node_modules/
web/.next/
web/out/
